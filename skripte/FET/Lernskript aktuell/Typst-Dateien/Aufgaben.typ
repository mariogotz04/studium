#aufgabe(titel: "FAQ: Drosseltemperatur bei realem Wasserdampf", art: "verstehen", quelle: "4.3", herkunft: "original", vorlage: "FAQ des Dozenten, Stand 14.11.2022, PDF-S. 15", minuten: 3)[
