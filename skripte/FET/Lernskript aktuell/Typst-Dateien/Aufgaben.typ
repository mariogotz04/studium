#aufgabe(titel: "Altklausur WS 02/03: Kurzfrage 11", art: "verstehen", quelle: "4.5", herkunft: "original", minuten: 3, vorlage: "Altklausur WS 02/03, Kurzfrage 11 (Import 12.11.2026, PDF-S. 1)")[
