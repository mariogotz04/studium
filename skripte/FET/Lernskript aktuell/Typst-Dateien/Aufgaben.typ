#aufgabe(titel: "Kurzfrage: Ideale Gasgleichung in differenzieller Form", art: "verstehen", quelle: "1.6.1", herkunft: "original", vorlage: "Leistungsnachweis WS 11/12, Aufg. 0a", minuten: 3)[
