#aufgabe(titel: "Stickstoff: Heizerenergie und Zustandsgrößen", art: "rechnen", quelle: "3.2.1", herkunft: "original", vorlage: "Übungsaufgaben WS 23/24, Aufg. 2.1 e–g", minuten: 20)[
