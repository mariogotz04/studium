#aufgabe(titel: "Wärmestrom und zeitliches Temperaturfeld unterscheiden", art: "verstehen", quelle: "6.8", herkunft: "eigen", vorlage: "MT PDF-S.38,Gl.10.1/10.9", minuten: 4)[
