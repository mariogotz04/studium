#aufgabe(titel: "SM LN SS 01: Kurzfrage 4.1", art: "verstehen", quelle: "9.10", herkunft: "original", vorlage: "SM LN SS01, gescannter Kurzfragenteil, Frage 4.1, PDF-S.3 (offene Fassung der ursprünglichen Auswahlfrage)", minuten: 4)[
