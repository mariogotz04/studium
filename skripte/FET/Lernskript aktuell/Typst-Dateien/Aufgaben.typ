#aufgabe(titel: "Altklausur WS 00/01: Kurzfrage 8", art: "verstehen", quelle: "4.7", herkunft: "original", minuten: 3, vorlage: "Altklausur WS 00/01, Kurzfrage 8 (Import 12.11.2026, PDF-S. 2)")[
