#aufgabe(titel: "SM LN SS 01: Kurzfrage 1.4", art: "verstehen", quelle: "9.4", herkunft: "original", vorlage: "SM LN SS01, gescannter Kurzfragenteil, Frage 1.4, PDF-S.1 (offene Fassung der ursprünglichen Auswahlfrage)", minuten: 4)[
