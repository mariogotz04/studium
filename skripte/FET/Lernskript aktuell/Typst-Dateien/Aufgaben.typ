#aufgabe(titel: "Kurzfrage: Was spezifische Zustandsgrößen sind", art: "verstehen", quelle: "1.4", herkunft: "original", vorlage: "Leistungsnachweis SS 14, Kurzfrage 7", minuten: 3)[
