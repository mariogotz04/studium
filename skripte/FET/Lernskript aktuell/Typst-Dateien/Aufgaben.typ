#aufgabe(titel: "S1 Buchaufgabe 1.27: Radiale Strömung zwischen Kreisplatten", art: "rechnen", quelle: "9.4", herkunft: "original", vorlage: "S1 Hydrostatik, PDF-S. 19 verweist auf BS, Aufgabe1.27, PDF-S.47", minuten: 15)[
