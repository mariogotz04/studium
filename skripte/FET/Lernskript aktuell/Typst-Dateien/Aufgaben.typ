#aufgabe(titel: "S23 Buchaufgabe 2.23: Prandtlrohr auf einem fahrenden Pkw", art: "rechnen", quelle: "9.4", herkunft: "original", vorlage: "S23 Bernoulli/Rohrströmung, PDF-S. 4 verweist auf BS, Aufgabe2.23, PDF-S.83", minuten: 25)[
