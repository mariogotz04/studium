#aufgabe(titel: "FAQ: Ersatzdrossel mit idealem Helium", art: "verstehen", quelle: "5.2", herkunft: "original", vorlage: "FAQ des Dozenten, Stand 14.11.2022, PDF-S. 32", minuten: 3)[
