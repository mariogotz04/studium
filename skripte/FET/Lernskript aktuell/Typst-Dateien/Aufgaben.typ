#aufgabe(titel: "Übung 1.13: Berthelot-Zustandsgleichung und Ableitungen", art: "rechnen", quelle: "2.12", herkunft: "original", vorlage: "Übungsaufgaben WS 23/24, Aufg. 1.13", minuten: 35)[
