#aufgabe(titel: "SM PF SS 02: Kurzfrage 6", art: "verstehen", quelle: "9.4", herkunft: "original", vorlage: "SM PF SS 02, Kurzfrage 6, PDF-S.1; Musterlösung PDF-S.3", minuten: 4)[
