#aufgabe(titel: "Altklausur WS 01/02: Kurzfrage 11", art: "verstehen", quelle: "4.7", herkunft: "original", minuten: 3, vorlage: "Altklausur WS 01/02, Kurzfrage 11 (Import 12.11.2026, PDF-S. 2)")[
