]

#aufgabe(titel: "Altklausur WS 05/06: Kurzfrage 4", art: "verstehen", quelle: "3.8.1", herkunft: "original", minuten: 3, vorlage: "Altklausur WS 05/06, Kurzfrage 4 (Import 12.11.2026, PDF-S. 1)")[
