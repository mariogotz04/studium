#aufgabe(titel: "Altklausur WS 04/05: Kurzfrage 4", art: "verstehen", quelle: "3.9", herkunft: "original", minuten: 3, vorlage: "Altklausur WS 04/05, Kurzfrage 4 (Import 12.11.2026, PDF-S. 1)")[
