#aufgabe(titel: "SM PF SS 06: Asymmetrischer Keil ohne horizontale Haltekraft", art: "rechnen", quelle: "9.7", herkunft: "original", vorlage: "SM PF SS 06, Aufgabe 3.1–3.4, PDF-S.5; Lösung PDF-S.12", minuten: 25)[
