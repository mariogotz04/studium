#aufgabe(titel: "Übung 4.13: Ungenutztes Gasturbinenabgas", art: "rechnen", quelle: "4.9.2", herkunft: "original", minuten: 20, vorlage: "Übungsaufgaben WS 23/24, Aufg. 4.13")[
