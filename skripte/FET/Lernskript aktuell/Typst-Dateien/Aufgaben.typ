#aufgabe(titel: "SM PF WS 02/03: Schwimmendes Partyglas und stationäres Sinken", art: "rechnen", quelle: "9.2", herkunft: "original", vorlage: "SM PF WS 02/03, Aufgabe1.1–1.4, PDF-S.5; LösungS.8", minuten: 30)[
